              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "2. 全用系統原生的勾選框和選單，鍵盤與 VoiceOver 不用另外處理。",
              "lineHeight": 1.6,
              "fontFamily": "Noto Sans TC",
              "fontSize": 14,
              "fontWeight": "normal"
